{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "milliondollartheme/masonry-portfolio-gallery",
    "title": "Masonry Portfolio Gallery",
    "category": "milliondollartheme-blocks",
    "description": "Displays portfolio items in a Pinterest-style masonry layout.",
    "icon": "images-alt",
    "keywords": ["portfolio", "gallery", "grid", "masonry", "projects", "images"],
    "attributes": {
        "selectedCategories": { "type": "string", "default": "" },
        "selectedTags": { "type": "string", "default": "" },
        "numberOfItems": { "type": "number", "default": 9 },
        "orderBy": { "type": "string", "default": "date" },
        "order": { "type": "string", "default": "DESC" },
        "columnMinWidth": { "type": "number", "default": 250 },
        "columnsTablet": { "type": "number" },
        "columnsMobile": { "type": "number" },
        "imageSize": { "type": "string", "default": "medium_large" },
        "imageAspectRatio": { "type": "string", "default": "auto" },
        "showPostTitleOnHover": { "type": "boolean", "default": true },
        "hoverEffect": { "type": "string", "default": "zoom" },
        "itemStyle": { "type": "string", "default": "default" },
        "gap": { "type": "number", "default": 16 },
        "showFilterBar": { "type": "boolean", "default": false },
        "filterBy": { "type": "string", "default": "category" },
        "paginationType": { "type": "string", "default": "none" },
        "loadMoreButtonText": { "type": "string", "default": "Load More" },
        "align": { "type": "string", "default": "" }
    },
    "supports": {
        "align": ["wide", "full"],
        "html": false,
        "anchor": true
    },
    "textdomain": "milliondollartheme",
    "editorScript": "file:./index.js",
    "style": "file:./style-index.css",
    "viewScript": "file:./view.js",
    "render": "file:./render.php"
}
